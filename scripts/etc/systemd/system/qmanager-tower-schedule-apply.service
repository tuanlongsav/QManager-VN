# /lib/systemd/system/qmanager-tower-schedule-apply.service
#
# TIMER-TRIGGERED ONLY — see the [Install] note at the bottom before editing.
# Paired with qmanager-tower-schedule-apply.timer, generated at save time by
# /usr/bin/qmanager_tower_schedule_arm. That helper arms this unit and the
# matching -clear unit together, all-or-nothing, so the window can never open
# without something scheduled to close it.
[Unit]
Description=QManager Tower Schedule (apply lock)
After=qmanager-setup.service qmanager-poller.service

# Skip cleanly rather than fail when the worker is absent. Condition* is only
# honoured in [Unit]; under [Service] it is inert and the unit runs anyway.
ConditionFileIsExecutable=/usr/bin/qmanager_tower_schedule

[Service]
Type=oneshot
ExecStart=/usr/bin/qmanager_tower_schedule apply

# Locking a cell sends AT commands through the flock-serialised transport and
# may wait behind the poller. Comfortably above that, well under the 90 s
# default it replaces being too tight for a contended /dev/smd11.
TimeoutStartSec=300

# Deliberately NO RemainAfterExit — see qmanager-scheduled-reboot.service for
# why a oneshot that stays active can only ever be triggered once. It matters
# most here: this unit is meant to fire on every scheduled day, not once.

# NO [Install] SECTION, ON PURPOSE. enable_services() reads the absence of one
# as "never boot-enable this unit". Boot-enabling it would apply a cell lock on
# every boot regardless of the configured window. The .timer carries
# WantedBy=timers.target instead.
