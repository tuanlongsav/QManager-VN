#!/bin/sh
# =============================================================================
# qmanager_watchcat — QManager Connection Health Watchdog
# =============================================================================
# A pure state machine that monitors internet health by reading the ping
# daemon's output and executes tiered recovery actions when connectivity
# is lost. It NEVER pings on its own.
#
# States: MONITOR → SUSPECT → RECOVERY → COOLDOWN → (back to MONITOR)
#         LOCKED (maintenance mode — sleeps until lock removed)
#
# Escalation Tiers:
#   Tier 1: Network deregister/reregister (AT+COPS=2/0)
#   Tier 2: Radio toggle (AT+CFUN=0/1) — skipped if tower lock active
#   Tier 3: SIM failover (AT+QUIMSLOT) — Golden Rule sequence
#   Tier 4: System reboot — token bucket: max N/hour, auto-disables
#
# Data flow:
#   Reads:  /tmp/qmanager_ping.json (from ping daemon)
#   Writes: /tmp/qmanager_watchcat.json (for poller consumption)
#           /tmp/qmanager_recovery_active (during any recovery)
#           /etc/qmanager/sim_failover.json (on Tier 3 success — persistent)
#           /etc/qmanager/crash.log (Tier 4 reboot log)
#
# Install location: /usr/bin/qmanager_watchcat
# Dependencies: jq, qcmd, qlog.sh, events.sh
# =============================================================================

# --- Logging -----------------------------------------------------------------
. /usr/lib/qmanager/qlog.sh 2>/dev/null || {
    qlog_init() { :; }; qlog_debug() { :; }; qlog_info() { :; }
    qlog_warn() { :; }; qlog_error() { :; }; qlog_state_change() { :; }
}
qlog_init "watchcat"

# --- Events (for append_event) -----------------------------------------------
# Must define EVENTS_FILE and MAX_EVENTS before sourcing events.sh
EVENTS_FILE="/tmp/qmanager_events.json"
MAX_EVENTS=50
. /usr/lib/qmanager/events.sh 2>/dev/null || {
    append_event() { :; }
}

# --- Config helper (RM520N-GL: replaces UCI) ---------------------------------
[ -f /usr/lib/qmanager/config.sh ] && . /usr/lib/qmanager/config.sh
[ -f /usr/lib/qmanager/platform.sh ] && . /usr/lib/qmanager/platform.sh
# profile_mgr.sh is optional the same way it is in qmanager_poller: the
# recovery ladder has to keep working on a tree where the profile feature was
# never installed. Both functions this daemon borrows from it need a stand-in,
# because an undefined function in `sh` is not an error the caller notices — it
# writes "not found" to stderr and yields an empty string, which every call
# site here then reads as a real answer.
. /usr/lib/qmanager/profile_mgr.sh 2>/dev/null || {
    # Tier 3 and its fallback lose the ICCID-matched profile re-apply after a
    # SIM swap. Acceptable: the swap itself is the part that restores
    # connectivity, and there are no profiles to apply on such a tree anyway.
    auto_apply_profile() { :; }
    # Identity fallback, not a no-op — same reasoning as the poller, different
    # damage. The resume cross-check below canonicalizes both the stored and
    # the live ICCID; undefined, both come back empty, both -n guards fail, and
    # the check quietly does nothing while the log still reports the state as
    # "verified by slot". The blind spot that check exists to close — a
    # different SIM pushed into the same slot — silently reopens. Passing the
    # value through keeps the comparison alive and degrades only to the old
    # pad-blind matching, whose worst case is discarding good state on an
    # F-padded SIM.
    iccid_canonicalize() { printf '%s' "$1"; }
}

# --- File Paths --------------------------------------------------------------
PING_CACHE="/tmp/qmanager_ping.json"
STATE_FILE="/tmp/qmanager_watchcat.json"
STATE_TMP="/tmp/qmanager_watchcat.json.tmp"
PID_FILE="/tmp/qmanager_watchcat.pid"
RECOVERY_FLAG="/tmp/qmanager_recovery_active"
LOCK_FILE="/tmp/qmanager_watchcat.lock"
RELOAD_FLAG="/tmp/qmanager_watchcat_reload"
REVERT_FLAG="/tmp/qmanager_watchcat_revert_sim"
DISABLED_FLAG="/tmp/qmanager_watchcat_disabled"
# Persistent, not /tmp. Tier 3 swaps the SIM and the ladder escalates to a
# reboot right after, so state kept on tmpfs is gone precisely when it is
# needed: the resume block below exists to pick this up "from before reboot"
# and could never once have run. /etc/qmanager is created by the installer and
# chowned to www-data so the CGI can read it.
SIM_FAILOVER_FILE="/etc/qmanager/sim_failover.json"
LONG_RUNNING_FLAG="/tmp/qmanager_long_running"
PROFILE_APPLY_PID="/tmp/qmanager_profile_apply.pid"
TOWER_LOCK_CONFIG="/etc/qmanager/tower_lock.json"
CRASH_LOG="/etc/qmanager/crash.log"

# --- Documented defaults -----------------------------------------------------
# These mirror the DEFAULTS heredoc in /usr/lib/qmanager/config.sh. They are
# their own constants rather than only the initial CFG_* values because
# read_config falls back to them when a stored value is unusable, and after a
# config reload the CFG_* variables hold the last loaded value, not the default.
DEF_CHECK_INTERVAL=10
DEF_MAX_FAILURES=5
DEF_COOLDOWN=60
DEF_MAX_REBOOTS_PER_HOUR=3

# --- Configuration (defaults, overridden by UCI) -----------------------------
CFG_ENABLED=1
CFG_CHECK_INTERVAL=$DEF_CHECK_INTERVAL
CFG_MAX_FAILURES=$DEF_MAX_FAILURES
CFG_COOLDOWN=$DEF_COOLDOWN
CFG_TIER1_ENABLED=1
CFG_TIER2_ENABLED=1
CFG_TIER3_ENABLED=0
CFG_TIER4_ENABLED=1
CFG_BACKUP_SIM_SLOT=""
CFG_MAX_REBOOTS_PER_HOUR=$DEF_MAX_REBOOTS_PER_HOUR
BOOT_SETTLE=30
PING_STALE_THRESHOLD=15
MODEM_WAIT_TIMEOUT=60

# --- State Variables ---------------------------------------------------------
state="monitor"
prev_state=""
failure_counter=0
current_tier=0
last_recovery_time="null"
last_recovery_tier="null"
total_recoveries=0
cooldown_remaining=0
sim_failover_active="false"
original_sim_slot="null"
current_sim_slot="null"
reboots_this_hour=0

# =============================================================================
# CONFIGURATION
# =============================================================================

# --- Defensive floor for the numeric settings --------------------------------
#
# The accepted range for these settings — the policy — is defined once, in
# scripts/www/cgi-bin/quecmanager/monitoring/watchdog.sh, where MAX_FAILURES_MIN
# and friends both clamp on GET and reject on POST. What follows is deliberately
# NOT a second copy of those numbers.
#
# Why the daemon checks at all: it can be started from a qmanager.conf no UI
# ever wrote — hand-edited over SSH, or left by a build that predates that
# validation. check_interval is the sleep of the main loop *and* the decrement
# step of the cooldown, so a stored 0, 1 or "fast" spins the recovery daemon on
# the ARMv7 core until somebody happens to save the settings page once. A
# daemon must not take a sleep value on trust from a file, whatever the UI in
# front of that file enforces.
#
# A shared bounds library sourced by both was the alternative, and it does not
# actually collapse the duplication: it would have to ship into
# /usr/lib/qmanager (an installer change), and the daemon would still need a
# fallback for the case where it is missing — exactly as with profile_mgr.sh
# above — so the defensive numbers would survive anyway and the library would
# be a third place rather than one place.
#
# What keeps these from drifting into the CGI's bounds is that they are not the
# same rule: the daemon enforces floors only, never ceilings. A floor is safety
# (a busy loop; an escalation with no pause between tiers); a ceiling is policy
# and belongs to the UI. Every value the CGI accepts already sits above these
# floors, so the daemon's rule is strictly weaker and cannot contradict it —
# and where a floor is derivable from something the daemon already holds, it is
# derived rather than written down. Only WATCHCAT_MIN_INTERVAL is a bare
# number, and it describes the hardware (one loop iteration costs a jq state
# write, a date, and a parse of the ping cache), not a preference. If the
# CGI's minimum is ever lowered below it, this floor wins, and says so in the
# log rather than silently.
WATCHCAT_MIN_INTERVAL=5

# cfg_int <value> <default> <floor> <name>
#
# Echo <value> when it is a plain whole number at or above <floor>, otherwise
# echo the replacement and log why — a config the daemon corrected in silence
# is one the next reader still believes.
#
# Non-numeric falls back to the documented default rather than the floor:
# "fast" expresses no intent to sit near the floor, so the default is the only
# honest guess. Ten or more digits are folded into the same case — a value that
# `[ -lt ]` cannot parse is garbage for this purpose, and comparing it would
# fail open (the test errors, reports false, and the value sails through).
#
# Warnings go to stderr because every caller reads this through a command
# substitution: with QLOG_TO_STDOUT=1 the log line would otherwise be captured
# *as* the setting's value.
cfg_int() {
    case "$1" in
        ''|*[!0-9]*|??????????*)
            qlog_warn "Config $4='$1' is not a usable number — using default $2" >&2
            printf '%s' "$2"
            return ;;
    esac

    # All digits is not yet safe to hand to $(( )), which reads a leading zero
    # as octal: a hand-written "010" would quietly mean 8, and "08" is a hard
    # syntax error that would take out the cooldown decrement in the main loop.
    # Strip the zeros here, once, rather than leaving each arithmetic site to
    # discover the problem.
    local v="$1"
    while :; do
        case "$v" in 0[0-9]*) v="${v#0}" ;; *) break ;; esac
    done

    if [ "$v" -lt "$3" ]; then
        qlog_warn "Config $4=$v below the daemon's floor of $3 — using $3" >&2
        printf '%s' "$3"
        return
    fi
    printf '%s' "$v"
}

read_config() {
    CFG_ENABLED=$(qm_config_get watchcat enabled 1)

    local val
    val=$(qm_config_get watchcat check_interval "")
    [ -n "$val" ] && CFG_CHECK_INTERVAL=$(cfg_int "$val" \
        "$DEF_CHECK_INTERVAL" "$WATCHCAT_MIN_INTERVAL" check_interval)

    # Floor of 1: at 0 the `-ge` in the suspect branch is satisfied on the very
    # first tick, firing the recovery ladder before a single failure has been
    # confirmed.
    val=$(qm_config_get watchcat max_failures "")
    [ -n "$val" ] && CFG_MAX_FAILURES=$(cfg_int "$val" "$DEF_MAX_FAILURES" 1 max_failures)

    # Floor derived, not chosen: cooldown_remaining is decremented by
    # CFG_CHECK_INTERVAL, so anything shorter than one tick is indistinguishable
    # from zero — and zero means the ladder walks tier to tier, up to and
    # including a reboot, without ever pausing for the network to come back.
    # Read after check_interval on purpose, so the floor is the sanitized one.
    val=$(qm_config_get watchcat cooldown "")
    [ -n "$val" ] && CFG_COOLDOWN=$(cfg_int "$val" \
        "$DEF_COOLDOWN" "$CFG_CHECK_INTERVAL" cooldown)

    val=$(qm_config_get watchcat tier1_enabled "")
    [ -n "$val" ] && CFG_TIER1_ENABLED="$val"

    val=$(qm_config_get watchcat tier2_enabled "")
    [ -n "$val" ] && CFG_TIER2_ENABLED="$val"

    val=$(qm_config_get watchcat tier3_enabled "")
    [ -n "$val" ] && CFG_TIER3_ENABLED="$val"

    val=$(qm_config_get watchcat tier4_enabled "")
    [ -n "$val" ] && CFG_TIER4_ENABLED="$val"

    CFG_BACKUP_SIM_SLOT=$(qm_config_get watchcat backup_sim_slot "")

    # Floor of 0, i.e. shape only. Zero is already the safe side — the token
    # bucket reads as spent, so Tier 4 auto-disables the watchcat instead of
    # rebooting. What must not survive is a non-numeric value: the token-bucket
    # test compares it with `-ge`, which on garbage errors out and reports
    # false, and false there reads as "budget available" — the one input that
    # would let this daemon reboot the device without limit.
    val=$(qm_config_get watchcat max_reboots_per_hour "")
    [ -n "$val" ] && CFG_MAX_REBOOTS_PER_HOUR=$(cfg_int "$val" \
        "$DEF_MAX_REBOOTS_PER_HOUR" 0 max_reboots_per_hour)

    qlog_info "Config loaded: interval=${CFG_CHECK_INTERVAL}s max_fail=${CFG_MAX_FAILURES} cooldown=${CFG_COOLDOWN}s"
    qlog_info "  Tiers: T1=${CFG_TIER1_ENABLED} T2=${CFG_TIER2_ENABLED} T3=${CFG_TIER3_ENABLED} T4=${CFG_TIER4_ENABLED} backup_sim=${CFG_BACKUP_SIM_SLOT:-none}"
}

# =============================================================================
# STATE FILE WRITER
# =============================================================================

write_state() {
    local ts
    ts=$(date +%s)

    # sf_active is passed with --arg, not --argjson, on purpose: the shell
    # variable holds the *strings* "true"/"false" and the filter below compares
    # it against "true". With --argjson, jq would parse it into a real boolean,
    # and `true == "true"` is false — leaving sim_failover_active permanently
    # false in the state file and the failover badge permanently dark.
    jq -n -c \
        --argjson ts "$ts" \
        --argjson enabled "$CFG_ENABLED" \
        --arg state "$state" \
        --argjson tier "$current_tier" \
        --argjson failures "$failure_counter" \
        --argjson last_time "${last_recovery_time:-null}" \
        --argjson last_tier "${last_recovery_tier:-null}" \
        --argjson total "$total_recoveries" \
        --argjson cooldown "$cooldown_remaining" \
        --arg sf_active "$sim_failover_active" \
        --argjson sf_orig "${original_sim_slot:-null}" \
        --argjson sf_curr "${current_sim_slot:-null}" \
        --argjson reboots "$reboots_this_hour" \
        '{
            timestamp: $ts, enabled: ($enabled == 1),
            state: $state, current_tier: $tier,
            failure_count: $failures,
            last_recovery_time: $last_time,
            last_recovery_tier: $last_tier,
            total_recoveries: $total,
            cooldown_remaining: $cooldown,
            sim_failover_active: ($sf_active == "true"),
            original_sim_slot: $sf_orig,
            current_sim_slot: $sf_curr,
            reboots_this_hour: $reboots
        }' > "$STATE_TMP"

    mv "$STATE_TMP" "$STATE_FILE"
}

# =============================================================================
# HELPERS
# =============================================================================

# Check if maintenance mode is active (any lock condition)
check_locked() {
    # Explicit maintenance lock
    [ -f "$LOCK_FILE" ] && return 0

    # Long-running AT command (cell scan, firmware update)
    [ -f "$LONG_RUNNING_FLAG" ] && return 0

    # Profile apply in progress
    if [ -f "$PROFILE_APPLY_PID" ]; then
        local pid
        pid=$(cat "$PROFILE_APPLY_PID" 2>/dev/null)
        if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
            return 0
        fi
    fi

    return 1
}

# Check if tower lock is active (Tier 2 must be skipped)
tower_lock_active() {
    [ ! -f "$TOWER_LOCK_CONFIG" ] && return 1
    local lte_locked nr_locked
    lte_locked=$(jq -r '(.lte.enabled) | if . == null then "false" else tostring end' \
        "$TOWER_LOCK_CONFIG" 2>/dev/null)
    nr_locked=$(jq -r '(.nr_sa.enabled) | if . == null then "false" else tostring end' \
        "$TOWER_LOCK_CONFIG" 2>/dev/null)
    if [ "$lte_locked" = "true" ] || [ "$nr_locked" = "true" ]; then
        return 0
    fi
    return 1
}

# Read ping daemon data — returns 0 if valid, 1 if stale/missing
# Sets: ping_streak_fail, ping_reachable, ping_during_recovery, ping_connectivity, ping_limited_reason
ping_streak_fail=0
ping_reachable="true"
ping_during_recovery="false"
ping_connectivity="connected"
ping_limited_reason="null"

read_ping() {
    if [ ! -f "$PING_CACHE" ]; then
        qlog_warn "Ping cache missing"
        return 1
    fi

    local _pdata
    _pdata=$(jq -r '[
        (.timestamp | if . == null then "0" else tostring end),
        ((.streak_fail) | if . == null then "0" else tostring end),
        ((.reachable) | if . == null then "true" else tostring end),
        ((.during_recovery) | if . == null then "false" else tostring end),
        ((.connectivity) | if . == null then "disconnected" else tostring end),
        ((.limited_reason) | if . == null then "null" else tostring end)
    ] | @tsv' "$PING_CACHE" 2>/dev/null)

    [ -z "$_pdata" ] && return 1

    local ping_ts
    ping_ts=$(printf '%s' "$_pdata" | cut -f1)
    ping_streak_fail=$(printf '%s' "$_pdata" | cut -f2)
    ping_reachable=$(printf '%s' "$_pdata" | cut -f3)
    ping_during_recovery=$(printf '%s' "$_pdata" | cut -f4)
    ping_connectivity=$(printf '%s' "$_pdata" | cut -f5)
    ping_limited_reason=$(printf '%s' "$_pdata" | cut -f6)

    # Staleness check
    local now age
    now=$(date +%s)
    age=$((now - ping_ts))
    if [ "$age" -gt "$PING_STALE_THRESHOLD" ]; then
        qlog_warn "Ping data stale (age=${age}s), skipping cycle"
        return 1
    fi

    return 0
}

# Count reboots in the last hour from crash.log
count_recent_reboots() {
    if [ ! -f "$CRASH_LOG" ]; then
        reboots_this_hour=0
        return
    fi
    local now cutoff count
    now=$(date +%s)
    cutoff=$((now - 3600))
    count=$(awk -v cutoff="$cutoff" -F'|' '$1 >= cutoff { n++ } END { print n+0 }' "$CRASH_LOG" 2>/dev/null)
    reboots_this_hour="${count:-0}"
}

# Wait for modem to respond to AT commands after recovery action
wait_for_modem() {
    local elapsed=0
    while [ "$elapsed" -lt "$MODEM_WAIT_TIMEOUT" ]; do
        if qcmd 'AT' >/dev/null 2>&1; then
            qlog_info "Modem responsive after ${elapsed}s"
            return 0
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    qlog_error "Modem unresponsive after ${MODEM_WAIT_TIMEOUT}s"
    return 1
}

# =============================================================================
# RECOVERY TIERS
# =============================================================================

execute_tier1() {
    qlog_info "TIER 1: Re-register to network (AT+COPS)"
    append_event "watchcat_recovery" "Watchcat: re-register to network (Tier 1)" "warning"

    touch "$RECOVERY_FLAG"
    qcmd 'AT+COPS=2' 2>/dev/null
    sleep 2
    qcmd 'AT+COPS=0' 2>/dev/null
    return 0
}

execute_tier2() {
    # Pre-check: tower lock
    if tower_lock_active; then
        qlog_warn "TIER 2 SKIPPED: tower lock active"
        return 1  # signal to skip this tier
    fi

    # Pre-check: long-running command
    if [ -f "$LONG_RUNNING_FLAG" ]; then
        qlog_warn "TIER 2 SKIPPED: long-running AT command active"
        return 1
    fi

    qlog_info "TIER 2: Toggling radio (AT+CFUN=0/1)"
    append_event "watchcat_recovery" "Watchcat: toggling radio (Tier 2)" "warning"

    touch "$RECOVERY_FLAG"

    local result
    result=$(qcmd 'AT+CFUN=0' 2>/dev/null)
    if [ $? -ne 0 ]; then
        qlog_error "TIER 2: AT+CFUN=0 failed"
        return 0  # action attempted, enter cooldown
    fi

    sleep 3

    qcmd 'AT+CFUN=1' >/dev/null 2>&1
    wait_for_modem
    return 0
}

execute_tier3() {
    # Pre-check: backup SIM configured
    if [ -z "$CFG_BACKUP_SIM_SLOT" ]; then
        qlog_warn "TIER 3 SKIPPED: no backup SIM slot configured"
        return 1
    fi

    # Read current SIM slot
    local current_slot_raw current_slot
    current_slot_raw=$(qcmd 'AT+QUIMSLOT?' 2>/dev/null)
    current_slot=$(printf '%s' "$current_slot_raw" | grep '+QUIMSLOT:' | sed 's/.*: *//' | tr -d '\r ')

    if [ -z "$current_slot" ]; then
        qlog_error "TIER 3: Cannot read current SIM slot"
        return 1
    fi

    if [ "$CFG_BACKUP_SIM_SLOT" = "$current_slot" ]; then
        qlog_warn "TIER 3 SKIPPED: backup slot ($CFG_BACKUP_SIM_SLOT) equals current slot ($current_slot)"
        return 1
    fi

    qlog_info "TIER 3: SIM failover from slot $current_slot to slot $CFG_BACKUP_SIM_SLOT"
    append_event "sim_failover" "Watchcat: switching to SIM slot $CFG_BACKUP_SIM_SLOT (Tier 3)" "warning"

    touch "$RECOVERY_FLAG"

    # Save original slot for potential fallback
    original_sim_slot="$current_slot"

    # Stop tower failover daemon (locks are meaningless on different SIM)
    svc_stop qmanager_tower_failover

    # Golden Rule SIM swap sequence: CFUN=0 → 2s → QUIMSLOT → 2s → CFUN=1
    local result
    result=$(qcmd 'AT+CFUN=0' 2>/dev/null)
    if [ $? -ne 0 ]; then
        qlog_error "TIER 3: AT+CFUN=0 failed, aborting SIM failover"
        svc_start qmanager_tower_failover
        return 0  # action attempted
    fi

    sleep 2

    qcmd "AT+QUIMSLOT=$CFG_BACKUP_SIM_SLOT" >/dev/null 2>&1
    sleep 2
    qcmd 'AT+CFUN=1' >/dev/null 2>&1

    # Wait for modem to come back
    if ! wait_for_modem; then
        qlog_error "TIER 3: Modem unresponsive after SIM switch, falling back"
        sim_failover_fallback
        return 0
    fi

    # Verify SIM presence
    local cpin_result
    cpin_result=$(qcmd 'AT+CPIN?' 2>/dev/null)
    if printf '%s' "$cpin_result" | grep -q 'ERROR'; then
        qlog_error "TIER 3: No SIM in backup slot $CFG_BACKUP_SIM_SLOT, falling back"
        sim_failover_fallback
        return 0
    fi

    # Read new ICCID for logging
    local new_iccid_raw new_iccid iccid_suffix
    new_iccid_raw=$(qcmd 'AT+QCCID' 2>/dev/null)
    new_iccid=$(printf '%s' "$new_iccid_raw" | grep '+QCCID:' | sed 's/+QCCID: //g' | tr -d '\r ')
    iccid_suffix=$(printf '%s' "$new_iccid" | tail -c 4)

    current_sim_slot="$CFG_BACKUP_SIM_SLOT"
    qlog_info "TIER 3: Switched to slot $CFG_BACKUP_SIM_SLOT (ICCID: ...$iccid_suffix)"

    # Don't write SIM failover state yet — wait for cooldown to verify connectivity
    # The cooldown handler will check reachability and finalize
    return 0
}

# Fallback: revert SIM to original slot
sim_failover_fallback() {
    qlog_warn "SIM failover fallback: reverting to slot $original_sim_slot"
    append_event "sim_failover" "Watchcat: backup SIM failed, reverting to slot $original_sim_slot" "warning"

    # Golden Rule sequence back to original
    qcmd 'AT+CFUN=0' >/dev/null 2>&1
    sleep 2
    qcmd "AT+QUIMSLOT=$original_sim_slot" >/dev/null 2>&1
    sleep 2
    qcmd 'AT+CFUN=1' >/dev/null 2>&1

    wait_for_modem

    # Restart tower failover daemon
    svc_start qmanager_tower_failover

    # Auto-apply matching profile for the reverted SIM
    local _revert_iccid
    _revert_iccid=$(qcmd 'AT+QCCID' 2>/dev/null | grep '+QCCID:' | sed 's/+QCCID: //g' | tr -d '\r ')
    [ -n "$_revert_iccid" ] && auto_apply_profile "$_revert_iccid" "watchdog_revert"

    current_sim_slot="$original_sim_slot"
    sim_failover_active="false"
    original_sim_slot="null"

    # The state file lives in /etc now, not /tmp, so a reboot no longer clears
    # it for us. Leaving it behind would outlive the failover it describes: the
    # CGI serves this file verbatim as `sim_failover` while `status` comes from
    # write_state, so a stale active:true makes one response contradict itself
    # and keeps the failover badge lit on a SIM we already reverted away from.
    rm -f "$SIM_FAILOVER_FILE"
}

execute_tier4() {
    # Token bucket check
    count_recent_reboots
    if [ "$reboots_this_hour" -ge "$CFG_MAX_REBOOTS_PER_HOUR" ]; then
        qlog_error "TIER 4: Reboot limit reached (${reboots_this_hour}/${CFG_MAX_REBOOTS_PER_HOUR} per hour)"
        qlog_error "TIER 4: Auto-disabling watchcat"
        append_event "watchcat_recovery" "Watchcat disabled: reboot limit exceeded (${reboots_this_hour} reboots/hour)" "error"

        # Permanently disable via JSON config
        qm_config_set watchcat enabled 0

        CFG_ENABLED=0
        state="disabled"
        touch "$DISABLED_FLAG"
        write_state
        rm -f "$RECOVERY_FLAG"

        # Exit — systemd won't restart since config disabled
        exit 0
    fi

    qlog_error "TIER 4: System reboot (recovery ${reboots_this_hour}/${CFG_MAX_REBOOTS_PER_HOUR})"
    append_event "watchcat_recovery" "Watchcat: rebooting system (Tier 4)" "error"

    # Log reboot to crash.log (persists across reboots)
    local ts
    ts=$(date +%s)
    echo "${ts}|reboot|tier4_escalation" >> "$CRASH_LOG"

    # Trim crash.log to last 20 entries
    if [ -f "$CRASH_LOG" ]; then
        local count
        count=$(wc -l < "$CRASH_LOG" 2>/dev/null || echo 0)
        if [ "$count" -gt 20 ]; then
            tail -n 20 "$CRASH_LOG" > "${CRASH_LOG}.tmp"
            mv "${CRASH_LOG}.tmp" "$CRASH_LOG"
        fi
    fi

    last_recovery_time="$ts"
    last_recovery_tier=4
    total_recoveries=$((total_recoveries + 1))
    write_state
    rm -f "$RECOVERY_FLAG"

    # Reboot after flushing state
    ( sleep 1 && reboot ) &
    exit 0
}

# =============================================================================
# ESCALATION ENGINE
# =============================================================================

# Find the next enabled tier >= start_tier. Returns 0 if found (sets
# current_tier), 1 if no tiers left.
find_next_tier() {
    local start="$1"
    local t="$start"

    while [ "$t" -le 4 ]; do
        case "$t" in
            1) [ "$CFG_TIER1_ENABLED" = "1" ] && { current_tier="$t"; return 0; } ;;
            2) [ "$CFG_TIER2_ENABLED" = "1" ] && { current_tier="$t"; return 0; } ;;
            3) [ "$CFG_TIER3_ENABLED" = "1" ] && { current_tier="$t"; return 0; } ;;
            4) [ "$CFG_TIER4_ENABLED" = "1" ] && { current_tier="$t"; return 0; } ;;
        esac
        t=$((t + 1))
    done
    return 1  # no enabled tiers remaining
}

do_recovery() {
    local action_result=0

    qlog_info "RECOVERY: Executing Tier $current_tier"
    touch "$RECOVERY_FLAG"

    case "$current_tier" in
        1) execute_tier1; action_result=$? ;;
        2) execute_tier2; action_result=$? ;;
        3) execute_tier3; action_result=$? ;;
        4) execute_tier4; action_result=$? ;;  # may not return (reboot/exit)
    esac

    # If tier was skipped (returned 1), try next tier
    if [ "$action_result" -ne 0 ]; then
        qlog_info "Tier $current_tier skipped, trying next"
        if find_next_tier $((current_tier + 1)); then
            do_recovery  # recurse with next tier
        else
            qlog_error "No more enabled tiers — all recovery options exhausted"
            rm -f "$RECOVERY_FLAG"
            state="monitor"
            current_tier=0
            failure_counter=0
        fi
        return
    fi

    # Recovery action executed — enter cooldown
    local ts
    ts=$(date +%s)
    last_recovery_time="$ts"
    last_recovery_tier="$current_tier"
    total_recoveries=$((total_recoveries + 1))
    cooldown_remaining="$CFG_COOLDOWN"
    state="cooldown"
    qlog_info "Entering COOLDOWN for ${CFG_COOLDOWN}s (after Tier $current_tier)"
}

# =============================================================================
# COOLDOWN COMPLETION
# =============================================================================

finish_cooldown() {
    rm -f "$RECOVERY_FLAG"

    # Re-read ping data to check if recovery worked
    if read_ping && [ "$ping_reachable" = "true" ]; then
        qlog_info "COOLDOWN complete: connectivity RESTORED after Tier $current_tier"

        # If this was Tier 3 SIM failover, finalize the failover state
        if [ "$current_tier" -eq 3 ] && [ "$current_sim_slot" != "$original_sim_slot" ] && [ "$original_sim_slot" != "null" ]; then
            sim_failover_active="true"

            # Read ICCIDs for the state file
            local orig_iccid curr_iccid_raw curr_iccid
            orig_iccid=""  # we don't have it cached
            curr_iccid_raw=$(qcmd 'AT+QCCID' 2>/dev/null)
            curr_iccid=$(printf '%s' "$curr_iccid_raw" | grep '+QCCID:' | sed 's/+QCCID: //g' | tr -d '\r ')

            local ts
            ts=$(date +%s)
            printf '{"active":true,"original_slot":%s,"current_slot":%s,"switched_at":%d,"reason":"connectivity_failure","original_iccid":"","current_iccid":"%s"}\n' \
                "$original_sim_slot" "$current_sim_slot" "$ts" "$curr_iccid" \
                > "$SIM_FAILOVER_FILE"

            qlog_info "SIM failover state saved: slot $original_sim_slot → $current_sim_slot"

            # Auto-apply matching profile for the new SIM
            if [ -n "$curr_iccid" ]; then
                auto_apply_profile "$curr_iccid" "watchdog"
            fi
        fi

        # Reset — connectivity recovered
        state="monitor"
        current_tier=0
        failure_counter=0
    else
        qlog_warn "COOLDOWN complete: connectivity NOT restored after Tier $current_tier"

        # If Tier 3 failed to restore connectivity, fall back
        if [ "$current_tier" -eq 3 ] && [ "$current_sim_slot" != "$original_sim_slot" ] && [ "$original_sim_slot" != "null" ]; then
            sim_failover_fallback
        fi

        # Escalate to next tier
        if find_next_tier $((current_tier + 1)); then
            state="suspect"
            failure_counter="$CFG_MAX_FAILURES"  # will trigger recovery immediately
            qlog_info "Escalating to Tier $current_tier"
        else
            qlog_error "All recovery tiers exhausted — returning to monitor"
            state="monitor"
            current_tier=0
            failure_counter=0
        fi
    fi
}

# =============================================================================
# USER-REQUESTED SIM REVERT
# =============================================================================

check_revert_request() {
    if [ -f "$REVERT_FLAG" ] && [ "$sim_failover_active" = "true" ]; then
        qlog_info "User requested SIM revert to slot $original_sim_slot"
        rm -f "$REVERT_FLAG"
        append_event "sim_failover" "Watchcat: reverting to original SIM slot $original_sim_slot (user request)" "info"

        touch "$RECOVERY_FLAG"
        sim_failover_fallback
        rm -f "$RECOVERY_FLAG" "$SIM_FAILOVER_FILE"

        sim_failover_active="false"
        state="monitor"
        current_tier=0
        failure_counter=0
        return 0
    fi
    rm -f "$REVERT_FLAG"  # clean up stale flag
    return 1
}

# =============================================================================
# MAIN LOOP
# =============================================================================

main() {
    # Prevent duplicate instances
    if [ -f "$PID_FILE" ]; then
        local old_pid
        old_pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            qlog_error "Another watchcat already running (PID $old_pid), exiting"
            exit 1
        fi
        rm -f "$PID_FILE"
    fi
    echo $$ > "$PID_FILE"

    # Cleanup on exit
    trap 'rm -f "$PID_FILE" "$STATE_TMP" "$RECOVERY_FLAG"; write_state' EXIT INT TERM

    # Read configuration
    read_config

    if [ "$CFG_ENABLED" != "1" ]; then
        qlog_info "Watchcat disabled in config, exiting"
        exit 0
    fi

    qlog_info "========================================"
    qlog_info "QManager Watchcat starting (PID $$)"
    qlog_info "========================================"

    # Count reboots from crash.log (persisted across reboots)
    count_recent_reboots
    qlog_info "Reboots in last hour: $reboots_this_hour"

    # Check for stale SIM failover state from before reboot
    if [ -f "$SIM_FAILOVER_FILE" ]; then
        local sf_active_val
        sf_active_val=$(jq -r '(.active) | if . == null then "false" else tostring end' "$SIM_FAILOVER_FILE" 2>/dev/null)
        if [ "$sf_active_val" = "true" ]; then
            local _sf_stored_slot _sf_live_raw _sf_live_slot
            local _sf_stored_iccid _sf_live_iccid _sf_discard _sf_verified
            _sf_stored_slot=$(jq -r '(.current_slot) | if . == null then "null" else tostring end' "$SIM_FAILOVER_FILE" 2>/dev/null)

            # Now that this state outlives a reboot, it can also outlive the
            # situation that produced it — the user may have moved the SIM or
            # changed slots by hand while the daemon was down. Resuming a
            # failover that is no longer in effect would leave the daemon
            # believing it owes the user a revert to a slot they already left.
            #
            # Two independent cross-checks, because either alone has a blind
            # spot: the slot catches a manual slot change, the ICCID catches a
            # different SIM pushed into the *same* slot (AT+QUIMSLOT? still says
            # 2, so the slot check waves it through).
            #
            # Only DISCARD on a positive contradiction — both sides of a
            # comparison must be readable before a difference means anything.
            # An unreadable slot or ICCID here means the modem has not finished
            # coming up (this runs before the boot-settle sleep), not that the
            # state is wrong; so does an absent stored ICCID, which older state
            # files and any failover where AT+QCCID came back empty will have.
            # Treating either as a mismatch would throw away good state on every
            # slow boot.
            _sf_live_raw=$(qcmd 'AT+QUIMSLOT?' 2>/dev/null)
            _sf_live_slot=$(printf '%s' "$_sf_live_raw" | grep '+QUIMSLOT:' | sed 's/.*: *//' | tr -d '\r ')

            _sf_discard=""
            _sf_verified=""
            if [ -n "$_sf_live_slot" ] && [ -n "$_sf_stored_slot" ] \
               && [ "$_sf_stored_slot" != "null" ]; then
                if [ "$_sf_live_slot" != "$_sf_stored_slot" ]; then
                    _sf_discard="recorded slot $_sf_stored_slot, modem reports $_sf_live_slot (slot changed while daemon was down)"
                else
                    _sf_verified="slot"
                fi
            fi

            # Skipped once the slot already contradicted: the state is going
            # away regardless, and this spares a second AT read on a modem that
            # may still be booting.
            if [ -z "$_sf_discard" ]; then
                # iccid_canonicalize() comes from profile_mgr.sh (sourced above,
                # same place auto_apply_profile does; identity fallback there if
                # that library is absent) and strips the trailing
                # BCD pad 'F' the modem reports, which only some readers in this
                # tree keep — comparing raw would flag a false mismatch.
                _sf_stored_iccid=$(jq -r '(.current_iccid) | if . == null then "" else tostring end' "$SIM_FAILOVER_FILE" 2>/dev/null)
                _sf_stored_iccid=$(iccid_canonicalize "$_sf_stored_iccid")
                _sf_live_iccid=$(qcmd 'AT+QCCID' 2>/dev/null | grep '+QCCID:' | sed 's/+QCCID: //g' | tr -d '\r ')
                _sf_live_iccid=$(iccid_canonicalize "$_sf_live_iccid")

                if [ -n "$_sf_live_iccid" ] && [ -n "$_sf_stored_iccid" ] \
                   && [ "$_sf_live_iccid" != "$_sf_stored_iccid" ]; then
                    _sf_discard="recorded ICCID ...$(printf '%s' "$_sf_stored_iccid" | tail -c 4), modem reports ...$(printf '%s' "$_sf_live_iccid" | tail -c 4) (different SIM in slot $_sf_stored_slot while daemon was down)"
                elif [ -n "$_sf_live_iccid" ] && [ -n "$_sf_stored_iccid" ]; then
                    _sf_verified="${_sf_verified:+$_sf_verified+}iccid"
                fi
            fi

            if [ -n "$_sf_discard" ]; then
                qlog_warn "Discarding SIM failover state: $_sf_discard"
                rm -f "$SIM_FAILOVER_FILE"
            else
                sim_failover_active="true"
                original_sim_slot=$(jq -r '(.original_slot) | if . == null then "null" else tostring end' "$SIM_FAILOVER_FILE" 2>/dev/null)
                current_sim_slot="$_sf_stored_slot"
                if [ -z "$_sf_verified" ]; then
                    qlog_info "Resuming SIM failover state: slot $original_sim_slot → $current_sim_slot (unverified — modem not ready yet)"
                else
                    qlog_info "Resuming SIM failover state: slot $original_sim_slot → $current_sim_slot (verified by $_sf_verified)"
                fi
            fi
        fi
    fi

    # Boot settle — let modem and other daemons stabilize
    qlog_info "Boot settle: waiting ${BOOT_SETTLE}s"
    write_state
    sleep "$BOOT_SETTLE"

    # --- Main monitoring loop ---
    while true; do
        # Check for config reload request
        if [ -f "$RELOAD_FLAG" ]; then
            rm -f "$RELOAD_FLAG"
            qlog_info "Config reload requested"
            read_config
            if [ "$CFG_ENABLED" != "1" ]; then
                qlog_info "Watchcat disabled via config reload, exiting"
                state="disabled"
                write_state
                exit 0
            fi
        fi

        # Check for user SIM revert request
        check_revert_request

        # --- LOCKED state check ---
        if check_locked; then
            if [ "$state" != "locked" ]; then
                qlog_info "Entering LOCKED state (maintenance)"
                state="locked"
            fi
            write_state
            sleep "$CFG_CHECK_INTERVAL"
            continue
        fi

        # Exiting locked state
        if [ "$state" = "locked" ]; then
            qlog_info "Exiting LOCKED state"
            state="monitor"
            failure_counter=0
        fi

        # --- COOLDOWN state ---
        if [ "$state" = "cooldown" ]; then
            cooldown_remaining=$((cooldown_remaining - CFG_CHECK_INTERVAL))
            if [ "$cooldown_remaining" -le 0 ]; then
                cooldown_remaining=0
                finish_cooldown
            fi
            write_state
            sleep "$CFG_CHECK_INTERVAL"
            continue
        fi

        # --- Read ping data ---
        if ! read_ping; then
            # Stale or missing data — don't make recovery decisions
            write_state
            sleep "$CFG_CHECK_INTERVAL"
            continue
        fi

        # --- Carrier intercept (limited) check ---
        # connectivity=limited means a carrier-side wall (billing portal, data
        # cap, activation walled garden) is intercepting traffic. Recovery
        # actions (modem reset, cfun toggle, SIM failover, reboot) cannot help.
        # Stay in monitor and clear any pending recovery flag.
        if [ "$ping_connectivity" = "limited" ]; then
            if [ "$state" != "monitor" ]; then
                qlog_info "$state → MONITOR: carrier-limited (HTTP $ping_limited_reason); abandoning recovery"
                state="monitor"
                failure_counter=0
                rm -f "$RECOVERY_FLAG"
            elif [ -n "$ping_limited_reason" ] && [ "$ping_limited_reason" != "null" ]; then
                # First detection in monitor — log once per entry into limited
                if [ "${prev_limited_reason:-null}" = "null" ]; then
                    qlog_info "MONITOR: carrier-limited (HTTP $ping_limited_reason); recovery suppressed"
                fi
            fi
            prev_limited_reason="$ping_limited_reason"
            write_state
            sleep "$CFG_CHECK_INTERVAL"
            continue
        fi
        prev_limited_reason="null"

        # --- State machine ---
        case "$state" in
            monitor)
                if [ "$ping_streak_fail" -gt 0 ]; then
                    prev_state="$state"
                    state="suspect"
                    failure_counter=1
                    qlog_info "MONITOR → SUSPECT: streak_fail=$ping_streak_fail"
                fi
                ;;

            suspect)
                if [ "$ping_reachable" = "true" ] && [ "$ping_streak_fail" -eq 0 ]; then
                    # Naturally recovered
                    qlog_info "SUSPECT → MONITOR: connectivity restored naturally"
                    state="monitor"
                    failure_counter=0
                else
                    failure_counter=$((failure_counter + 1))
                    qlog_debug "SUSPECT: failure_counter=$failure_counter/$CFG_MAX_FAILURES"

                    if [ "$failure_counter" -ge "$CFG_MAX_FAILURES" ]; then
                        qlog_warn "SUSPECT → RECOVERY: threshold breached ($failure_counter >= $CFG_MAX_FAILURES)"
                        state="recovery"

                        # Find first enabled tier
                        if [ "$current_tier" -eq 0 ]; then
                            find_next_tier 1
                        fi

                        do_recovery
                    fi
                fi
                ;;

            recovery)
                # Should not stay here — do_recovery transitions to cooldown
                # If we're here, something went wrong
                qlog_warn "Unexpected RECOVERY state in main loop, resetting"
                state="monitor"
                failure_counter=0
                current_tier=0
                ;;
        esac

        write_state
        sleep "$CFG_CHECK_INTERVAL"
    done
}

main "$@"
