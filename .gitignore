# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifacts
qmanager-build/
qmanager_install/
RELEASE_NOTE.md

# claude superpowers
/.superpowers
/docs/superpowers
/.claude

# simpleadmin source
/simpleadmin-source

# bundled build tools (developer-local; not part of the repo)
/tools/

# Health check directory
/health-checks/

# Investigation scratch (probe scripts, raw logs)
/scratch/

# Rust ping-daemon build output
/ping-daemon/target/

# Code intelligence / session tooling state (machine-local, not shared)
/.codegraph/
/.remember/

# Editor state
.vscode/
.idea/

# scripts/dev/icloud-exclude.sh parks the regenerable artefacts here, where the
# ".nosync" suffix hides them from iCloud, and leaves symlinks in their place.
# The rules above end in "/" so they match directories only, and git does not
# count a symlink as a directory — without the slash-less repeats below, a
# `git add -A` after --apply would happily stage the replacement symlinks.
/.artifacts.nosync/
/.next
/.codegraph
/qmanager-build

# macOS / Windows filesystem junk. iCloud and Finder also drop "name 2.ext"
# conflict copies into synced folders — those are caught during review, not
# here, since the pattern is too broad to ignore safely.
._*
.Spotlight-V100
.Trashes
Thumbs.db
